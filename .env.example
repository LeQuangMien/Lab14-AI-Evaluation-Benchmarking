# Preferred path when OpenAI has no credit.
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_AGENT_MODEL=openrouter/auto
OPENROUTER_JUDGE_MODEL=openrouter/auto
OPENROUTER_HTTP_REFERER=http://localhost
OPENROUTER_APP_TITLE=Lab14 AI Evaluation Factory

# Optional fallback if you want to use OpenAI directly instead of OpenRouter.
OPENAI_API_KEY=
OPENAI_AGENT_MODEL=gpt-4o-mini
OPENAI_JUDGE_MODEL=gpt-4o-mini

# Required for the second judge.
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_JUDGE_MODEL=claude-haiku-4-5-20251001

# Optional manual cost estimates for OpenRouter models. Leave 0 if unknown.
OPENROUTER_INPUT_COST_PER_1M=0
OPENROUTER_OUTPUT_COST_PER_1M=0

# Use this when OpenRouter free quota is exhausted.
# With this setup the agent and both judges use Anthropic directly.
AGENT_PROVIDER=anthropic
ANTHROPIC_AGENT_MODEL=claude-haiku-4-5-20251001
JUDGE_PRIMARY_PROVIDER=anthropic
ANTHROPIC_PRIMARY_JUDGE_MODEL=claude-sonnet-4-6
EVAL_CONCURRENCY=3
